{
  "info": {
    "_postman_id": "6c9d7b9d-19f6-4c21-a989-177aaff5e1cc",
    "name": "IronChannel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "30052488"
  },
  "item": [
    {
      "name": "JWT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "async function sha256(text) {",
              "    const data = new TextEncoder().encode(text);",
              "    const hashBuffer = await crypto.subtle.digest(\"SHA-256\", data);",
              "",
              "    return Array.from(new Uint8Array(hashBuffer))",
              "        .map(b => b.toString(16).padStart(2, \"0\"))",
              "        .join(\"\");",
              "}",
              "",
              "const now = Math.floor(Date.now() / 1000);",
              "",
              "pm.variables.set(\"iat\", now);",
              "pm.variables.set(\"exp\", now + 5); // Expires in 5 seconds",
              "",
              "const body = pm.request.body?.raw ?? \"\";",
              "const hash = await sha256(body);",
              "",
              "pm.variables.set(\"body_hash\", \"sha256:\" + hash);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "jwt",
          "jwt": [
            {
              "key": "payload",
              "value": "{\n    \"app_id\": \"skynet\",\n    \"iat\": {{iat}},\n    \"exp\": {{exp}},\n    \"body_hash\": \"{{body_hash}}\"\n}",
              "type": "string"
            },
            {
              "key": "secret",
              "value": "{{Secret}}",
              "type": "string"
            },
            {
              "key": "header",
              "value": "{\n    \"typ\":\"JWT\"\n}",
              "type": "string"
            },
            {
              "key": "addTokenTo",
              "value": "header",
              "type": "string"
            },
            {
              "key": "isSecretBase64Encoded",
              "value": false,
              "type": "boolean"
            },
            {
              "key": "algorithm",
              "value": "HS256",
              "type": "string"
            },
            {
              "key": "headerPrefix",
              "value": "Bearer",
              "type": "string"
            },
            {
              "key": "queryParamKey",
              "value": "token",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"a\":100,\"b\":\"200\"}",
          "options": {
